# Normalize line endings so Windows and CI checkouts agree.
* text=auto eol=lf

# Windows-only scripts (none yet) would need CRLF; keep the door open.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets (screenshots added later must not be mangled).
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.woff binary
*.woff2 binary
